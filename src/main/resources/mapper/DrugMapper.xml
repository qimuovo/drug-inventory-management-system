<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hxl.inventory.mapper.DrugMapper">

    <resultMap id="BaseResultMap" type="com.hxl.inventory.model.entity.Drug">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="drugName" column="drug_name" jdbcType="VARCHAR"/>
            <result property="drugCode" column="drug_code" jdbcType="VARCHAR"/>
            <result property="specification" column="specification" jdbcType="VARCHAR"/>
            <result property="manufacturerId" column="manufacturer_id" jdbcType="BIGINT"/>
            <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,drug_name,drug_code,
        specification,manufacturer_id,is_deleted,
        create_time,update_time
